extends ../layout

block content
  h1= title

  form(method='POST' action='/task' class='mt-4')
    div.form-group.mb-3
      label(for='title') Título:
      input#title.form-control(type='text', placeholder='Aprender Node.js' name='title' required='true')
    
    div.form-group.mb-3
      label(for='description') Descripción:
      textarea#description.form-control(placeholder='Hacer una API REST...' name='description' rows='4')
    
    button.btn.btn-primary(type='submit') Crear Tarea
