extends ../layout

block content

  h1 #{title}: #{data.title}
  p= data.description

  p ¿Realmente deseas eliminar esta Tarea?

  form(method='POST' action=`/task/${data._id}`)
    div.form-group.mb-3
      input#taskid.form-control(type='hidden', name='taskid', value=data._id )

    button.btn.btn-danger(type='submit') Eliminar
    a.btn.btn-secondary.ms-2(href=`/task/${data._id}`) Cancelar