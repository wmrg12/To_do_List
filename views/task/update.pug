extends ../layout

block content
  h1 #{title}: #{data.title}
  
  form(method='POST' action=`/task/${data._id}`)
    div.form-group.mb-3
      label(for='title') Título:
      input#title.form-control(type='text', name='title', value=data.title, required='true')
    
    div.form-group.mb-3
      label(for='description') Descripción:
      textarea#description.form-control(name='description', rows='4')= data.description
    
    div.form-group.mb-3
      div.form-check
        // checkbox handling in express needs value='true' so we can parse it easily
        input#completed.form-check-input(type='checkbox', name='completed', checked=data.completed, value='true')
        label.form-check-label(for='completed') Marcar como Completado

    button.btn.btn-primary(type='submit') Guardar Cambios
    a.btn.btn-secondary.ms-2(href=`/task/${data._id}`) Cancelar
