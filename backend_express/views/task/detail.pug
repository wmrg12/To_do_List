extends ../layout

block content
  h1= title
  p
    strong Descripcion: 
    | #{data.description}
  p
    strong Estado: 
    | #{data.completed ? 'Completado' : 'Pendiente'}
  p
    strong Creado: 
    | #{data.createdAt_formatted}
    
  hr

  div 
    a.btn.btn-warning.me-2(href=`/task/${data._id}?action=update`) Actualizar 
    a.btn.btn-danger(href=`/task/${data._id}?action=delete`) Eliminar 
